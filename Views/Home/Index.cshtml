@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mt-5">
    <h1 class="display-4">Добро пожаловать в AutoRent</h1>
    <p class="lead mt-4">Удобный сервис аренды автомобилей</p>
    <p class="mt-3">Выберите автомобиль из нашего каталога и забронируйте его на нужные даты</p>

    <div class="mt-5">
        <a asp-controller="Cars" asp-action="Index" class="btn btn-primary btn-lg">
            Посмотреть каталог автомобилей
        </a>
    </div>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-car-front-fill text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Широкий выбор</h5>
                    <p class="card-text">Более 6 автомобилей различных классов и марок</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check text-success" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Надёжность</h5>
                    <p class="card-text">Все автомобили проходят регулярное техническое обслуживание</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-credit-card text-info" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Прозрачные цены</h5>
                    <p class="card-text">Никаких скрытых платежей, вы платите только за аренду</p>
                </div>
            </div>
        </div>
    </div>
</div>
