@model AutoRent.Models.Car

@{
    ViewData["Title"] = $"{Model.Brand.Name} {Model.Model}";
}

<div class="container mt-4 mb-5">
    <!-- Навигация назад -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index">Каталог</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Brand.Name @Model.Model</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Изображение -->
        <div class="col-lg-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Brand.Name @Model.Model">
            }
            else
            {
                <div class="bg-light rounded shadow d-flex align-items-center justify-content-center"
                     style="height: 400px;">
                    <div class="text-center text-muted">
                        <i class="bi bi-car-front-fill" style="font-size: 8rem;"></i>
                        <h3 class="mt-3">@Model.Brand.Name</h3>
                    </div>
                </div>
            }
        </div>

        <!-- Информация -->
        <div class="col-lg-6">
            <h1 class="mb-3">@Model.Brand.Name @Model.Model</h1>

            <!-- Год и статус -->
            <p class="text-muted mb-4">
                <span class="badge bg-secondary fs-6">@Model.Year год</span>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success fs-6 ms-2">Доступен</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 ms-2">Недоступен</span>
                }
            </p>

            <!-- Цена -->
            <div class="card mb-4 border-primary">
                <div class="card-body text-center">
                    <h2 class="text-primary mb-0">@Model.PricePerDay.ToString("N0") ₽</h2>
                    <p class="text-muted mb-0">за день аренды</p>
                </div>
            </div>

            <!-- Описание -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5>Описание</h5>
                    <p>@Model.Description</p>
                </div>
            }

            <!-- Характеристики -->
            <h5>Характеристики</h5>
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th style="width: 40%;">Марка</th>
                        <td>@Model.Brand.Name</td>
                    </tr>
                    <tr>
                        <th>Модель</th>
                        <td>@Model.Model</td>
                    </tr>
                    <tr>
                        <th>Год выпуска</th>
                        <td>@Model.Year</td>
                    </tr>
                    <tr>
                        <th>Категория</th>
                        <td>@Model.Category.Name</td>
                    </tr>
                    <tr>
                        <th>Коробка передач</th>
                        <td>@Model.Transmission</td>
                    </tr>
                    <tr>
                        <th>Тип топлива</th>
                        <td>@Model.FuelType</td>
                    </tr>
                    <tr>
                        <th>Количество мест</th>
                        <td>@Model.Seats</td>
                    </tr>
                </tbody>
            </table>

            <!-- Кнопки действий -->
            <div class="d-grid gap-2 mt-4">
                @if (Model.IsAvailable)
                {
                    <button class="btn btn-primary btn-lg" disabled>
                        Забронировать (скоро будет доступно)
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg" disabled>
                        Недоступен для бронирования
                    </button>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">
                    ← Вернуться к каталогу
                </a>
            </div>
        </div>
    </div>
</div>
