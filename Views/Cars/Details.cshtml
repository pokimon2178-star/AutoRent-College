@model AutoRent.Models.Car

@{
    ViewData["Title"] = $"{Model.Brand.Name} {Model.Model}";
    var gallery = AutoRent.CarImageGallery.For(Model);
}

<div class="container mt-4 mb-5">
    <!-- Навигация назад -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index">Каталог</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Brand.Name @Model.Model</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Изображение -->
        <div class="col-lg-6">
            <div id="carGallery-@Model.Id" class="carousel slide" data-bs-ride="false">
                <div class="carousel-inner rounded shadow">
                    @for (var index = 0; index < gallery.Count; index++)
                    {
                        <div class="carousel-item @(index == 0 ? "active" : "")">
                            <img src="@gallery[index]" onerror="this.onerror=null;this.src='/images/cars/car-fallback.svg';" class="d-block w-100" style="height: 400px; object-fit: cover;"
                                 alt="@Model.Brand.Name @Model.Model, фото @(index + 1)" loading="@(index == 0 ? "eager" : "lazy")">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carGallery-@Model.Id" data-bs-slide="prev" aria-label="Предыдущее фото">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carGallery-@Model.Id" data-bs-slide="next" aria-label="Следующее фото">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
            <div class="row row-cols-3 g-2 mt-2" role="tablist">
                @for (var index = 0; index < gallery.Count; index++)
                {
                    <div class="col">
                        <button type="button" class="border-0 p-0 bg-transparent w-100" data-bs-target="#carGallery-@Model.Id" data-bs-slide-to="@index" aria-label="Фото @(index + 1)">
                            <img src="@gallery[index]" onerror="this.onerror=null;this.src='/images/cars/car-fallback.svg';" class="img-fluid rounded" style="height: 105px; width: 100%; object-fit: cover;" alt="Фото @(index + 1)" loading="lazy">
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Информация -->
        <div class="col-lg-6">
            <h1 class="mb-3">@Model.Brand.Name @Model.Model</h1>

            <!-- Год и статус -->
            <p class="text-muted mb-4">
                <span class="badge bg-secondary fs-6">@Model.Year год</span>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success fs-6 ms-2">Доступен</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 ms-2">Недоступен</span>
                }
            </p>

            <!-- Цена -->
            <div class="card mb-4 border-primary">
                <div class="card-body text-center">
                    <h2 class="text-primary mb-0">@Model.PricePerDay.ToString("N0") ₽</h2>
                    <p class="text-muted mb-0">за день аренды</p>
                </div>
            </div>

            <!-- Описание -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5>Описание</h5>
                    <p>@Model.Description</p>
                </div>
            }

            <!-- Характеристики -->
            <h5>Характеристики</h5>
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th style="width: 40%;">Марка</th>
                        <td>@Model.Brand.Name</td>
                    </tr>
                    <tr>
                        <th>Модель</th>
                        <td>@Model.Model</td>
                    </tr>
                    <tr>
                        <th>Год выпуска</th>
                        <td>@Model.Year</td>
                    </tr>
                    <tr>
                        <th>Категория</th>
                        <td>@Model.Category.Name</td>
                    </tr>
                    <tr>
                        <th>Коробка передач</th>
                        <td>@Model.Transmission</td>
                    </tr>
                    <tr>
                        <th>Тип топлива</th>
                        <td>@Model.FuelType</td>
                    </tr>
                    <tr>
                        <th>Количество мест</th>
                        <td>@Model.Seats</td>
                    </tr>
                </tbody>
            </table>

            <!-- Кнопки действий -->
            <div class="d-grid gap-2 mt-4">
                @if (Model.IsAvailable)
                {
                    <button class="btn btn-primary btn-lg" disabled>
                        Забронировать (скоро будет доступно)
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg" disabled>
                        Недоступен для бронирования
                    </button>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">
                    ← Вернуться к каталогу
                </a>
            </div>
        </div>
    </div>
</div>
