@model IEnumerable<AutoRent.Models.Car>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <!-- Изображение автомобиля -->
                    <img src="@AutoRent.CarImageGallery.For(car)[0]" onerror="this.onerror=null;this.src='/images/cars/car-fallback.svg';" class="card-img-top" alt="@car.Brand.Name @car.Model"
                         style="height: 200px; object-fit: cover;">

                    <div class="card-body">
                        <!-- Марка и модель -->
                        <h5 class="card-title">@car.Brand.Name @car.Model</h5>

                        <!-- Год выпуска -->
                        <p class="text-muted mb-2">
                            <small>@car.Year год</small>
                        </p>

                        <!-- Характеристики -->
                        <div class="mb-3">
                            <span class="badge bg-secondary me-1">@car.Category.Name</span>
                            <span class="badge bg-info text-dark me-1">@car.Transmission</span>
                            <span class="badge bg-success">@car.Seats мест</span>
                        </div>

                        <!-- Топливо -->
                        <p class="card-text mb-2">
                            <small class="text-muted">
                                <i class="bi bi-fuel-pump"></i> @car.FuelType
                            </small>
                        </p>

                        <!-- Цена -->
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="text-primary mb-0">@car.PricePerDay.ToString("N0") ₽</h4>
                                <small class="text-muted">за день</small>
                            </div>
                            <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-primary">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Автомобили не найдены</strong>
        <p class="mb-0 mt-2">Попробуйте изменить параметры фильтрации</p>
    </div>
}
